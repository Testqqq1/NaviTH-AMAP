<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.amap.api.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="14dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NAVITH  /  MAPS"
                    android:textColor="#0B2832"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AMAP • TH"
                    android:textColor="#087F76"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:textColor="#0B2832"
                    android:textSize="14sp"
                    android:hint="ค้นหาสถานที่ เช่น สยามพารากอน" />
                <Button
                    android:id="@+id/searchButton"
                    android:layout_width="72dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_primary"
                    android:text="ค้นหา"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="ผลการค้นหา • แตะเพื่อเลือกจุดหมาย"
                android:textColor="#56666A"
                android:textSize="12sp" />
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false">
                <LinearLayout
                    android:id="@+id/resultsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">
        <Button
            android:id="@+id/locationButton"
            android:layout_width="62dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_card"
            android:text="◎ GPS"
            android:textColor="#087F76"
            android:textSize="12sp" />
        <Button
            android:id="@+id/mapTypeButton"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:text="ธีมแผนที่"
            android:textColor="#0B2832"
            android:textSize="10sp" />
        <Button
            android:id="@+id/viewButton"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:text="3D"
            android:textColor="#087F76"
            android:textSize="12sp" />
        <Button
            android:id="@+id/trafficButton"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:text="จราจร"
            android:textColor="#0B2832"
            android:textSize="11sp" />
        <Button
            android:id="@+id/settingsButton"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:text="ตั้งค่า ⚙"
            android:textColor="#0B2832"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:background="@drawable/bg_card"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/speedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="◎ กำลังระบุตำแหน่ง GPS"
            android:textColor="#087F76"
            android:textStyle="bold"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="แตะค้างบนแผนที่เพื่อเลือกจุดหมาย หรือค้นหาด้านบน"
            android:textColor="#4C626B"
            android:textSize="13sp" />
        <LinearLayout
            android:id="@+id/routePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E9EEF0" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="จุดหมายปลายทาง"
                android:textColor="#71838C"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/destinationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:text="-"
                android:textColor="#092B32"
                android:textSize="18sp"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/modeDrive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="รถยนต์"
                    android:textSize="13sp" />
                <RadioButton
                    android:id="@+id/modeWalk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="เดินเท้า"
                    android:textSize="13sp" />
            </RadioGroup>
            <TextView
                android:id="@+id/routeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="เลือกวิธีเดินทางแล้วกดแสดงเส้นทาง"
                android:textColor="#4C626B"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/routeButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_primary"
                    android:text="แสดงเส้นทาง"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
                <Button
                    android:id="@+id/clearButton"
                    android:layout_width="88dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_outline"
                    android:text="ล้าง"
                    android:textColor="#0B2832" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
