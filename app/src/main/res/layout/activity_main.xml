<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.amap.api.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- One compact, tappable search surface instead of a permanent large form. -->
    <LinearLayout android:id="@+id/topSearchBar" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_gravity="top" android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
        android:background="@drawable/nav_bg_floating" android:elevation="2dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/searchBarButton"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center_vertical"
            android:orientation="horizontal" android:clickable="true" android:focusable="true"
            android:contentDescription="@string/search_title"
            android:paddingStart="17dp">
            <ImageView android:layout_width="24dp" android:layout_height="48dp"
                android:src="@drawable/nav_ic_search" android:scaleType="centerInside"
                android:contentDescription="@string/search_title" />
            <TextView android:id="@+id/searchBarTitle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="@string/search_placeholder" android:ellipsize="end"
                android:singleLine="true" android:textSize="16sp"
                android:textColor="@color/nav_secondary" />
        </LinearLayout>
        <ImageView android:id="@+id/voiceSearchButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/nav_ic_mic"
            android:clickable="true" android:focusable="true"
            android:contentDescription="@string/voice_search"/>
        <ImageView android:id="@+id/menuButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/nav_ic_menu"
            android:clickable="true" android:focusable="true"
            android:contentDescription="@string/settings" />
    </LinearLayout>

    <!-- GPS is contextual data, never part of the destination card. -->
    <TextView android:id="@+id/gpsStatus"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:layout_marginTop="82dp"
        android:layout_marginStart="16dp" android:background="@drawable/nav_bg_white"
        android:elevation="2dp" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="8dp" android:paddingBottom="8dp"
        android:maxWidth="250dp" android:ellipsize="end" android:singleLine="true"
        android:text="@string/gps_searching" android:visibility="gone"
        android:textColor="@color/nav_secondary" android:textSize="13sp" />

    <!-- Exactly two controls remain on the map. -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/zoomButtons"
            android:layout_width="52dp" android:layout_height="104dp"
            android:orientation="vertical" android:layout_marginBottom="9dp"
            android:background="@drawable/nav_bg_white" android:elevation="3dp">
            <TextView android:id="@+id/zoomPlusButton"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:gravity="center" android:text="+" android:textSize="29sp"
                android:textColor="@color/nav_text" android:clickable="true"
                android:focusable="true" android:contentDescription="ซูมเข้า"/>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:background="@color/nav_border"/>
            <TextView android:id="@+id/zoomMinusButton"
                android:layout_width="match_parent" android:layout_height="51dp"
                android:gravity="center" android:text="−" android:textSize="29sp"
                android:textColor="@color/nav_text" android:clickable="true"
                android:focusable="true" android:contentDescription="ซูมออก"/>
        </LinearLayout>
        <ImageView android:id="@+id/locationButton"
            android:layout_width="52dp" android:layout_height="52dp"
            android:background="@drawable/nav_bg_white" android:elevation="2dp"
            android:padding="12dp" android:src="@drawable/nav_ic_locate"
            android:clickable="true" android:focusable="true"
            android:contentDescription="@string/my_position"/>
        <ImageView android:id="@+id/mapTypeButton"
            android:layout_width="52dp" android:layout_height="52dp"
            android:layout_marginTop="8dp" android:background="@drawable/nav_bg_white"
            android:elevation="2dp" android:padding="12dp"
            android:src="@drawable/nav_ic_layers"
            android:clickable="true" android:focusable="true"
            android:contentDescription="@string/layers"/>
    </LinearLayout>

    <!-- NaviTH's original, AMap-inspired map-first home panel. No copied assets. -->
    <LinearLayout android:id="@+id/homePanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="8dp"
        android:orientation="vertical" android:elevation="6dp"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingBottom="10dp" android:background="@drawable/nav_bg_sheet">
        <TextView android:id="@+id/homeGrabber"
            android:layout_width="match_parent" android:layout_height="23dp"
            android:gravity="center" android:text="━━━━" android:textSize="17sp"
            android:textColor="@color/nav_border" android:clickable="true"
            android:focusable="true" android:contentDescription="@string/home_expand"/>
        <LinearLayout android:id="@+id/homeSearchButton"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/nav_bg_floating"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:clickable="true" android:focusable="true"
            android:contentDescription="@string/search_title">
            <ImageView android:layout_width="46dp" android:layout_height="48dp"
                android:padding="12dp" android:src="@drawable/nav_ic_search"
                android:contentDescription="@null"/>
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="ค้นหาสถานที่ ถนน และที่อยู่..."
                android:textSize="16sp" android:singleLine="true" android:ellipsize="end"
                android:textColor="@color/nav_text"/>
            <TextView android:layout_width="44dp" android:layout_height="48dp"
                android:gravity="center" android:text="⌕" android:textSize="25sp"
                android:textColor="@color/nav_secondary"/>
        </LinearLayout>
        <HorizontalScrollView android:id="@+id/homeTravelModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:id="@+id/homeQuickDrive" android:layout_width="78dp"
                    android:layout_height="83dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true"
                    android:focusable="true" android:contentDescription="ขับรถ">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                         android:padding="12dp"
                         android:src="@drawable/nav_min_car"
                         android:background="@drawable/nav_bg_subtle"
                         android:scaleType="fitCenter" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="5dp"
                        android:text="ขับรถ" android:textSize="12sp"
                        android:singleLine="true" android:ellipsize="end"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeQuickTransit" android:layout_width="78dp"
                    android:layout_height="83dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true"
                    android:focusable="true" android:contentDescription="ขนส่ง">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                         android:padding="12dp"
                         android:src="@drawable/nav_min_bus"
                         android:background="@drawable/nav_bg_subtle"
                         android:scaleType="fitCenter" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="5dp"
                        android:text="ขนส่ง" android:textSize="12sp"
                        android:singleLine="true" android:ellipsize="end"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeQuickRide" android:layout_width="78dp"
                    android:layout_height="83dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true"
                    android:focusable="true" android:contentDescription="Ride">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                         android:padding="12dp"
                         android:src="@drawable/nav_min_ride"
                         android:background="@drawable/nav_bg_subtle"
                         android:scaleType="fitCenter" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="5dp"
                        android:text="Ride" android:textSize="12sp"
                        android:singleLine="true" android:ellipsize="end"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeQuickWalk" android:layout_width="78dp"
                    android:layout_height="83dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true"
                    android:focusable="true" android:contentDescription="เดิน">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                         android:padding="12dp"
                         android:src="@drawable/nav_min_walk"
                         android:background="@drawable/nav_bg_subtle"
                         android:scaleType="fitCenter" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="5dp"
                        android:text="เดิน" android:textSize="12sp"
                        android:singleLine="true" android:ellipsize="end"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeQuickCycle" android:layout_width="78dp"
                    android:layout_height="83dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true"
                    android:focusable="true" android:contentDescription="จักรยาน">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                         android:padding="12dp"
                         android:src="@drawable/nav_min_bike"
                         android:background="@drawable/nav_bg_subtle"
                         android:scaleType="fitCenter" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="5dp"
                        android:text="จักรยาน" android:textSize="12sp"
                        android:singleLine="true" android:ellipsize="end"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeQuickMoto" android:layout_width="78dp"
                    android:layout_height="83dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true"
                    android:focusable="true" android:contentDescription="มอเตอร์ไซค์">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                         android:padding="12dp"
                         android:src="@drawable/nav_min_moto"
                         android:background="@drawable/nav_bg_subtle"
                         android:scaleType="fitCenter" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="5dp"
                        android:text="มอเตอร์ไซค์" android:textSize="12sp"
                        android:singleLine="true" android:ellipsize="end"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout android:id="@+id/homeSecondaryModes"
            android:layout_width="match_parent" android:layout_height="66dp"
            android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:id="@+id/homeQuickRoute" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="65dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true"
                    android:focusable="true" android:contentDescription="เส้นทาง">
                    <ImageView android:layout_width="52dp" android:layout_height="37dp"
                         android:padding="7dp"
                         android:src="@drawable/nav_min_route"
                         android:background="@drawable/nav_bg_subtle"
                         android:scaleType="fitCenter" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="5dp"
                        android:text="เส้นทาง" android:textSize="12sp"
                        android:singleLine="true" android:ellipsize="end"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeQuickPlaces" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="65dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true"
                    android:focusable="true" android:contentDescription="สำรวจ">
                    <ImageView android:layout_width="52dp" android:layout_height="37dp"
                         android:padding="7dp"
                         android:src="@drawable/nav_min_explore"
                         android:background="@drawable/nav_bg_subtle"
                         android:scaleType="fitCenter" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="5dp"
                        android:text="สำรวจ" android:textSize="12sp"
                        android:singleLine="true" android:ellipsize="end"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeQuickSaved" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="65dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true"
                    android:focusable="true" android:contentDescription="สถานที่โปรด">
                    <ImageView android:layout_width="52dp" android:layout_height="37dp"
                         android:padding="7dp"
                         android:src="@drawable/nav_min_favorite"
                         android:background="@drawable/nav_bg_subtle"
                         android:scaleType="fitCenter" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="5dp"
                        android:text="สถานที่โปรด" android:textSize="12sp"
                        android:singleLine="true" android:ellipsize="end"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeQuickLayers" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="65dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true"
                    android:focusable="true" android:contentDescription="ชั้นข้อมูล">
                    <ImageView android:layout_width="52dp" android:layout_height="37dp"
                         android:padding="7dp"
                         android:src="@drawable/nav_min_layers"
                         android:background="@drawable/nav_bg_subtle"
                         android:scaleType="fitCenter" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="5dp"
                        android:text="ชั้นข้อมูล" android:textSize="12sp"
                        android:singleLine="true" android:ellipsize="end"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/homeQuickSettings" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="65dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true"
                    android:focusable="true" android:contentDescription="ตั้งค่า">
                    <ImageView android:layout_width="52dp" android:layout_height="37dp"
                         android:padding="7dp"
                         android:src="@drawable/nav_min_settings"
                         android:background="@drawable/nav_bg_subtle"
                         android:scaleType="fitCenter" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:layout_marginTop="5dp"
                        android:text="ตั้งค่า" android:textSize="12sp"
                        android:singleLine="true" android:ellipsize="end"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/homeShortcutRow"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="3dp">
            <TextView android:id="@+id/homeShortcut"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="42dp" android:gravity="center"
                android:text="⌂  บ้าน" android:textSize="13sp"
                android:textColor="@color/nav_text" android:clickable="true"
                android:focusable="true" android:background="@drawable/nav_bg_subtle"
                android:contentDescription="@string/home_label"/>
            <TextView android:id="@+id/workShortcut"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="42dp" android:layout_marginStart="7dp"
                android:gravity="center" android:text="▣  ที่ทำงาน"
                android:textSize="13sp" android:textColor="@color/nav_text"
                android:clickable="true" android:focusable="true"
                android:background="@drawable/nav_bg_subtle"
                android:contentDescription="@string/work_label"/>
            <TextView android:id="@+id/recentShortcut"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="42dp" android:layout_marginStart="7dp"
                android:gravity="center" android:text="◷  ล่าสุด"
                android:textSize="13sp" android:textColor="@color/nav_text"
                android:clickable="true" android:focusable="true"
                android:background="@drawable/nav_bg_subtle"
                android:contentDescription="@string/recent_places"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/homeExpanded"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="7dp"
            android:visibility="gone">
            <TextView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/home_recent"
                android:textColor="@color/nav_secondary" android:padding="6dp"/>
            <LinearLayout android:id="@+id/homeRecentList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="9dp" android:layout_marginBottom="4dp"
            android:background="@color/nav_border"/>
        <LinearLayout android:id="@+id/homeBottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:id="@+id/tabHome" android:layout_width="0dp"
                    android:layout_height="53dp" android:layout_weight="1"
                    android:gravity="center" android:orientation="vertical"
                    android:focusable="true" android:clickable="true"
                    android:contentDescription="หน้าแรก">
                    <ImageView android:layout_width="match_parent" android:layout_height="29dp"
                         android:padding="4dp" android:scaleType="fitCenter"
                         android:src="@drawable/nav_min_home" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:text="หน้าแรก" android:textSize="11sp"
                        android:textColor="@color/nav_primary"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/tabExplore" android:layout_width="0dp"
                    android:layout_height="53dp" android:layout_weight="1"
                    android:gravity="center" android:orientation="vertical"
                    android:focusable="true" android:clickable="true"
                    android:contentDescription="สำรวจ">
                    <ImageView android:layout_width="match_parent" android:layout_height="29dp"
                         android:padding="4dp" android:scaleType="fitCenter"
                         android:src="@drawable/nav_min_explore" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:text="สำรวจ" android:textSize="11sp"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/tabTrips" android:layout_width="0dp"
                    android:layout_height="53dp" android:layout_weight="1"
                    android:gravity="center" android:orientation="vertical"
                    android:focusable="true" android:clickable="true"
                    android:contentDescription="เส้นทาง">
                    <ImageView android:layout_width="match_parent" android:layout_height="29dp"
                         android:padding="4dp" android:scaleType="fitCenter"
                         android:src="@drawable/nav_min_route" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:text="เส้นทาง" android:textSize="11sp"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/tabSaved" android:layout_width="0dp"
                    android:layout_height="53dp" android:layout_weight="1"
                    android:gravity="center" android:orientation="vertical"
                    android:focusable="true" android:clickable="true"
                    android:contentDescription="บันทึก">
                    <ImageView android:layout_width="match_parent" android:layout_height="29dp"
                         android:padding="4dp" android:scaleType="fitCenter"
                         android:src="@drawable/nav_min_favorite" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:text="บันทึก" android:textSize="11sp"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/tabMine" android:layout_width="0dp"
                    android:layout_height="53dp" android:layout_weight="1"
                    android:gravity="center" android:orientation="vertical"
                    android:focusable="true" android:clickable="true"
                    android:contentDescription="ของฉัน">
                    <ImageView android:layout_width="match_parent" android:layout_height="29dp"
                         android:padding="4dp" android:scaleType="fitCenter"
                         android:src="@drawable/nav_min_profile" android:contentDescription="@null"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:text="ของฉัน" android:textSize="11sp"
                        android:textColor="@color/nav_text"/>
                </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Only the destination is primary in this small, expandable sheet. -->
    <LinearLayout android:id="@+id/routePanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="12dp"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingBottom="14dp" android:paddingTop="8dp"
        android:background="@drawable/nav_bg_sheet" android:elevation="8dp"
        android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/sheetGrabber" android:layout_width="64dp"
            android:layout_height="24dp" android:layout_gravity="center_horizontal"
            android:gravity="center" android:contentDescription="@string/more_options"
            android:clickable="true" android:focusable="true"
            android:text="━━━━" android:textColor="#BCCDD1" android:textSize="19sp"/>
        <LinearLayout android:id="@+id/routeSheetHeader"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:gravity="center_vertical" android:clickable="true"
            android:focusable="true" android:orientation="horizontal"
            android:contentDescription="@string/more_options">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/destinationText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/nav_text" android:textSize="18sp"
                    android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/routeSummary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:maxLines="2"
                    android:text="@string/route_not_navigation"
                    android:textColor="@color/nav_secondary" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/clearButton" android:layout_width="48dp"
                android:layout_height="48dp" android:gravity="center"
                android:text="×" android:textSize="28sp"
                android:contentDescription="@string/close_route"
                android:clickable="true" android:focusable="true"
                android:textColor="@color/nav_secondary" />
        </LinearLayout>
        <LinearLayout android:id="@+id/routeExpanded"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone"
            android:layout_marginTop="6dp">
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/nav_border" />
            <RadioGroup android:id="@+id/modeGroup"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <RadioButton android:id="@+id/modeDrive" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:minHeight="48dp"
                    android:checked="true" android:buttonTint="@color/nav_primary"
                    android:text="@string/drive" android:textSize="14sp"/>
                <RadioButton android:id="@+id/modeWalk" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:minHeight="48dp"
                    android:layout_marginStart="24dp" android:buttonTint="@color/nav_primary"
                    android:text="@string/walk" android:textSize="14sp"/>
                <RadioButton android:id="@+id/modeCycle" android:layout_width="wrap_content"
                    android:layout_height="48dp" android:minHeight="48dp"
                    android:layout_marginStart="12dp" android:buttonTint="@color/nav_primary"
                    android:text="จักรยาน" android:textSize="14sp"/>
            </RadioGroup>

            <TextView android:id="@+id/addressLookupButton"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="⌖  ดูที่อยู่จากพิกัด"
                android:textSize="14sp" android:textColor="@color/nav_primary"
                android:clickable="true" android:focusable="true"
                android:contentDescription="@string/address_lookup" />
            <TextView android:id="@+id/addressResult"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="4dp" android:paddingEnd="4dp"
                android:textSize="12sp" android:textColor="@color/nav_secondary"
                android:maxLines="2" android:ellipsize="end"
                android:visibility="gone"/>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView android:id="@+id/saveHomeButton"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                    android:gravity="center_vertical" android:text="@string/home_set"
                    android:textSize="14sp" android:textColor="@color/nav_primary"
                    android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/saveWorkButton"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                    android:gravity="center_vertical" android:text="@string/work_set"
                    android:textSize="14sp" android:textColor="@color/nav_primary"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>
            <TextView android:id="@+id/favoriteButton"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="☆  บันทึกเป็นสถานที่โปรด"
                android:textSize="14sp" android:textColor="@color/nav_primary"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/etaText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="7dp" android:paddingBottom="7dp"
                android:textColor="@color/nav_secondary"
                android:textSize="13sp"
                android:text="@string/route_not_navigation" />
            <LinearLayout android:id="@+id/routeAlternatives"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView android:id="@+id/routeOptionsButton"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:gravity="center_vertical" android:text="@string/route_preferences"
                android:textSize="14sp" android:textColor="@color/nav_primary"
                android:clickable="true" android:focusable="true"
                android:contentDescription="@string/more_options"/>
        </LinearLayout>
            <Button android:id="@+id/startNavigationButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/nav_bg_button"
                android:text="@string/start_navigation_test"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:visibility="gone"
                android:contentDescription="@string/start_navigation_test" />
        <Button android:id="@+id/routeButton"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:background="@drawable/nav_bg_button"
            android:text="@string/view_route" android:textAllCaps="false"
            android:textColor="@android:color/white" android:textStyle="bold"
            android:textSize="15sp"/>
    </LinearLayout>

    <!-- Small info only when nothing is selected; never a full-width opaque card. -->
    <TextView android:id="@+id/statusText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|start" android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp" android:maxWidth="260dp"
        android:background="@drawable/nav_bg_white" android:elevation="1dp"
        android:padding="10dp" android:textSize="13sp" android:maxLines="2"
        android:visibility="gone"
        android:ellipsize="end" android:textColor="@color/nav_secondary"
        android:text="@string/search_empty"/>

    <!-- Separate foreground TEST navigation scene; never claims production guidance. -->
    <LinearLayout android:id="@+id/activeNavTop"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:layout_margin="12dp"
        android:orientation="vertical" android:background="@drawable/nav_bg_floating"
        android:elevation="8dp" android:padding="16dp"
        android:visibility="gone">
        <TextView android:id="@+id/activeNavPhase"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="MAPBOX · GPS TEST" android:textStyle="bold" android:textSize="11sp"
            android:textColor="@color/nav_warning"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="6dp">
            <ImageView android:layout_width="36dp" android:layout_height="42dp"
                android:padding="5dp" android:src="@drawable/nav_min_route"
                android:contentDescription="@null"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="12dp">
                <TextView android:id="@+id/activeNavDistance"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="-- ม." android:textSize="24sp" android:textStyle="bold"
                    android:textColor="@color/nav_text"/>
                <TextView android:id="@+id/activeNavInstruction"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="รอข้อมูลเลี้ยวจาก Mapbox..." android:textSize="15sp"
                    android:textColor="@color/nav_text" android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/activeNavBottom"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="12dp"
        android:orientation="vertical" android:background="@drawable/nav_bg_sheet"
        android:elevation="9dp" android:padding="16dp" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="นำทางแบบทดลอง · ไม่ใช่ระบบนำทางหลักขณะขับรถ"
            android:textSize="11sp" android:textColor="@color/nav_warning"
            android:maxLines="2"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView android:id="@+id/activeNavEta"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="ETA --:--"
                android:textColor="@color/nav_text" android:textStyle="bold" android:textSize="18sp"/>
            <TextView android:id="@+id/activeNavRemaining"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="-- กม." android:textColor="@color/nav_secondary"
                android:textSize="16sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <Button android:id="@+id/activeNavRecenter"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="50dp" android:text="ตำแหน่งของฉัน"
                android:textAllCaps="false" android:textColor="@color/nav_primary"
                android:background="@drawable/nav_bg_subtle"/>
            <Button android:id="@+id/activeNavStop"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="50dp" android:layout_marginStart="8dp"
                android:text="หยุดนำทาง" android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/nav_bg_button"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Search takes focus only when requested, with recent/favorites and POI suggestions. -->
    <LinearLayout android:id="@+id/searchOverlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/nav_card" android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
            android:paddingStart="8dp" android:paddingEnd="12dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/searchBack"
                android:layout_width="48dp" android:layout_height="48dp"
                android:text="‹" android:textSize="34sp" android:gravity="center"
                android:textColor="@color/nav_text" android:clickable="true"
                android:focusable="true" android:contentDescription="@string/back" />
            <EditText android:id="@+id/searchInput"
                android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:singleLine="true"
                android:imeOptions="actionSearch" android:inputType="text"
                android:background="@drawable/nav_bg_subtle"
                android:paddingStart="14dp" android:paddingEnd="12dp"
                android:textColor="@color/nav_text" android:textSize="16sp"
                android:hint="@string/search_placeholder"/>
            <TextView android:id="@+id/searchClear"
                android:layout_width="48dp" android:layout_height="48dp"
                android:text="×" android:textSize="29sp" android:gravity="center"
                android:textColor="@color/nav_secondary" android:clickable="true"
                android:focusable="true" android:contentDescription="@string/search_clear"/>
        </LinearLayout>
        <TextView android:id="@+id/searchResultsHeading"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:paddingStart="20dp" android:gravity="center_vertical"
            android:text="@string/recent_places" android:textStyle="bold"
            android:textColor="@color/nav_text" android:textSize="15sp"/>
        <LinearLayout android:id="@+id/resultsPanel"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical">
            <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
                android:fillViewport="false">
                <LinearLayout android:id="@+id/resultsList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:orientation="vertical"/>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
